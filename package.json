{
  "name": "@local/modeldial-leaderboard",
  "version": "1.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Modeldial boards for the DSH web GUI: coding, text-capability and harness leaderboards plus the subscription quota catalog",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "leaderboard",
    "modeldial"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JAYcodr/dsh-modeldial-leaderboard.git"
  },
  "homepage": "https://github.com/JAYcodr/dsh-modeldial-leaderboard#readme",
  "bugs": {
    "url": "https://github.com/JAYcodr/dsh-modeldial-leaderboard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
